%% ECG DATASET VISUALIZATION

- ECG with R peaks and bradycardia onset
- Instantaneous heart rate

clear;
clc;
close all;

%% Configuration

patients = 1:20;
eventNumbers = 1:3;

secondsBefore = 60;
secondsAfter = 20;

datasetFolder = fullfile( ...
    getenv('USERPROFILE'), ...
    'Desktop', ...
    'PRJ_A', ...
    'PICS_ECG');

%% Enter dataset folder

originalFolder = pwd;
cleanupObject = onCleanup(@() cd(originalFolder));

cd(datasetFolder);

%% Process patients

for patient = patients

    fprintf('\nPatient %d\n', patient);

    info = loadPatientInfo(patient);

    fprintf('Sampling frequency: %.0f Hz\n', info.Fs);
    fprintf('Bradycardia events: %d\n', numel(info.bradySamples));
    fprintf('R peaks: %d\n', numel(info.rPeakSamples));

    %% Create one figure for each patient

    patientFigure = figure( ...
        'Color', 'w', ...
        'Name', sprintf('PICS patient %d', patient), ...
        'NumberTitle', 'off', ...
        'Units', 'normalized', ...
        'Position', [0.05 0.05 0.90 0.88]);

    patientLayout = tiledlayout( ...
        patientFigure, ...
        3, ...
        2, ...
        'TileSpacing', 'compact', ...
        'Padding', 'compact');

    title( ...
        patientLayout, ...
        sprintf( ...
            'Patient %d — First three bradycardia events', ...
            patient), ...
        'FontWeight', 'bold');

    %% Plot events

    for eventNumber = eventNumbers

        ecgAxis = nexttile(patientLayout);
        heartRateAxis = nexttile(patientLayout);

        if eventNumber > numel(info.bradySamples)

            showMissingEvent(ecgAxis, eventNumber);
            showMissingEvent(heartRateAxis, eventNumber);

            continue;
        end

        eventData = loadEvent( ...
            info, ...
            eventNumber, ...
            secondsBefore, ...
            secondsAfter);

        plotECG(ecgAxis, eventData);
        plotHeartRate(heartRateAxis, eventData);
    end
end

drawnow;

%% ================================================================
% Local functions
% ================================================================

function info = loadPatientInfo(patient)
% Load header information and annotations.

    recordName = sprintf( ...
        'infant%d_ecg', ...
        patient);

    headerFile = ...
        [recordName '.hea'];

    %% Read sampling information

    fileID = fopen( ...
        headerFile, ...
        'r');

    firstLine = fgetl(fileID);

    fclose(fileID);

    tokens = strsplit( ...
        strtrim(firstLine));

    samplingText = regexp( ...
        tokens{3}, ...
        '^[0-9.]+', ...
        'match', ...
        'once');

    Fs = str2double( ...
        samplingText);

    totalSamples = str2double( ...
        tokens{4});

    %% Read annotations

    bradySamples = double( ...
        rdann(recordName, 'atr'));

    rPeakSamples = double( ...
        rdann(recordName, 'qrsc'));

    %% Store patient information

    info.patient = patient;
    info.recordName = recordName;

    info.Fs = Fs;
    info.totalSamples = totalSamples;

    info.bradySamples = ...
        bradySamples(:);

    info.rPeakSamples = ...
        rPeakSamples(:);
end


function data = loadEvent( ...
        info, ...
        eventNumber, ...
        secondsBefore, ...
        secondsAfter)
% Load one ECG window around a bradycardia event.

    eventSample = ...
        info.bradySamples(eventNumber);

    firstSample = max( ...
        1, ...
        round( ...
            eventSample - ...
            secondsBefore * info.Fs));

    lastSample = min( ...
        info.totalSamples, ...
        round( ...
            eventSample + ...
            secondsAfter * info.Fs));

    %% Read first ECG channel

    ecg = rdsamp( ...
        info.recordName, ...
        1, ...
        lastSample, ...
        firstSample);

    ecg = double( ...
        ecg(:));

    actualLastSample = ...
        firstSample + numel(ecg) - 1;

    sampleNumbers = ...
        (firstSample:actualLastSample)';

    relativeTime = ...
        (sampleNumbers - eventSample) / ...
        info.Fs;

    %% Select R peaks

    peaks = info.rPeakSamples( ...
        info.rPeakSamples >= firstSample & ...
        info.rPeakSamples <= actualLastSample);

    peakIndices = round( ...
        peaks - firstSample + 1);

    peakTimes = ...
        (peaks - eventSample) / ...
        info.Fs;

    %% Select bradycardia annotations

    bradyEvents = info.bradySamples( ...
        info.bradySamples >= firstSample & ...
        info.bradySamples <= actualLastSample);

    bradyTimes = ...
        (bradyEvents - eventSample) / ...
        info.Fs;

    %% Calculate instantaneous heart rate

    rrIntervals = ...
        diff(peaks) / info.Fs;

    heartRate = ...
        60 ./ rrIntervals;

    heartRateTime = ...
        (peaks(2:end) - eventSample) / ...
        info.Fs;

    validHeartRate = ...
        heartRate >= 20 & ...
        heartRate <= 400;

    heartRate = ...
        heartRate(validHeartRate);

    heartRateTime = ...
        heartRateTime(validHeartRate);

    %% Store event data

    data.eventNumber = eventNumber;

    data.Fs = info.Fs;

    data.ecg = ecg;
    data.relativeTime = relativeTime;

    data.peakIndices = peakIndices;
    data.peakTimes = peakTimes;

    data.bradyTimes = bradyTimes;

    data.heartRate = heartRate;
    data.heartRateTime = heartRateTime;

    data.secondsBefore = secondsBefore;
    data.secondsAfter = secondsAfter;
end


function plotECG(axisHandle, data)
% Plot ECG, R peaks and bradycardia onset.

    hold(axisHandle, 'on');

    plot( ...
        axisHandle, ...
        data.relativeTime, ...
        data.ecg, ...
        'LineWidth', ...
        0.8);

    scatter( ...
        axisHandle, ...
        data.peakTimes, ...
        data.ecg(data.peakIndices), ...
        15, ...
        'v', ...
        'filled');

    addBradycardiaMarkers( ...
        axisHandle, ...
        data.bradyTimes, ...
        data.Fs);

    xlim( ...
        axisHandle, ...
        [-data.secondsBefore data.secondsAfter]);

    xlabel(axisHandle, ...
        'Time (s)');

    ylabel(axisHandle, ...
        'ECG');

    title( ...
        axisHandle, ...
        sprintf( ...
            'Event %d — ECG', ...
            data.eventNumber));

    grid(axisHandle, 'on');
    box(axisHandle, 'on');
end


function plotHeartRate(axisHandle, data)
% Plot instantaneous heart rate.

    hold(axisHandle, 'on');

    plot( ...
        axisHandle, ...
        data.heartRateTime, ...
        data.heartRate, ...
        '-o', ...
        'MarkerSize', ...
        2.5, ...
        'LineWidth', ...
        0.9);

    yline( ...
        axisHandle, ...
        100, ...
        '--', ...
        '100 bpm threshold', ...
        'LineWidth', ...
        1.1);

    addBradycardiaMarkers( ...
        axisHandle, ...
        data.bradyTimes, ...
        data.Fs);

    xlim( ...
        axisHandle, ...
        [-data.secondsBefore data.secondsAfter]);

    xlabel(axisHandle, ...
        'Time (s)');

    ylabel(axisHandle, ...
        'Heart rate (bpm)');

    title( ...
        axisHandle, ...
        sprintf( ...
            'Event %d — Heart rate', ...
            data.eventNumber));

    grid(axisHandle, 'on');
    box(axisHandle, 'on');
end


function addBradycardiaMarkers( ...
        axisHandle, ...
        bradyTimes, ...
        Fs)
% Add bradycardia onset markers.

    for markerIndex = 1:numel(bradyTimes)

        markerTime = ...
            bradyTimes(markerIndex);

        if abs(markerTime) < 1 / Fs

            lineStyle = '-';
            lineWidth = 2;

        else

            lineStyle = '--';
            lineWidth = 1;
        end

        xline( ...
            axisHandle, ...
            markerTime, ...
            lineStyle, ...
            'Bradycardia onset', ...
            'LineWidth', ...
            lineWidth, ...
            'LabelVerticalAlignment', ...
            'bottom');
    end
end


function showMissingEvent( ...
        axisHandle, ...
        eventNumber)
% Show unavailable event message.

    axis(axisHandle, 'off');

    text( ...
        axisHandle, ...
        0.5, ...
        0.5, ...
        sprintf( ...
            'Event %d unavailable', ...
            eventNumber), ...
        'HorizontalAlignment', ...
        'center', ...
        'VerticalAlignment', ...
        'middle');
end

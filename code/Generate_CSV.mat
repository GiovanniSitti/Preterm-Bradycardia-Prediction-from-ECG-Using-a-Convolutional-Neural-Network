%% GENERATE ECG CSV FILES

clear;
clc;
close all;

%% Configuration

projectFolder = fullfile( ...
    getenv('USERPROFILE'), ...
    'Desktop', ...
    'PRJ_A');

datasetFolder = fullfile( ...
    projectFolder, ...
    'PICS_ECG');

outputFolder = fullfile( ...
    projectFolder, ...
    'CSV');

chunkSize = 250000;

bradyOnlyInfants = [2 3 4 6 7 8 9 10];
heartRateInfants = [2 3 4 5 6 7 8 9 10];

allInfants = unique( ...
    [bradyOnlyInfants heartRateInfants], ...
    'stable');

mkdir(outputFolder);

%% Enter dataset folder

originalFolder = pwd;
folderCleanup = onCleanup(@() cd(originalFolder));

cd(datasetFolder);

%% Read recording information

numberOfSubjects = numel(allInfants);

subjectInformation = repmat( ...
    struct( ...
        'infant', [], ...
        'recordName', '', ...
        'info', [], ...
        'usableSamples', [], ...
        'availableDuration', []), ...
    numberOfSubjects, ...
    1);

for subjectIndex = 1:numberOfSubjects

    infant = allInfants(subjectIndex);

    recordName = sprintf( ...
        'infant%d_ecg', ...
        infant);

    headerFile = fullfile( ...
        datasetFolder, ...
        [recordName '.hea']);

    info = readWFDBHeader( ...
        headerFile, ...
        datasetFolder);

    fileInformation = dir( ...
        info.dataFile);

    availableBytes = ...
        fileInformation.bytes - info.byteOffset;

    bytesPerSample = ...
        info.nSignals * 2;

    availableSamples = floor( ...
        availableBytes / bytesPerSample);

    usableSamples = min( ...
        availableSamples, ...
        info.nSamples);

    availableDuration = ...
        usableSamples / info.Fs;

    subjectInformation(subjectIndex).infant = ...
        infant;

    subjectInformation(subjectIndex).recordName = ...
        recordName;

    subjectInformation(subjectIndex).info = ...
        info;

    subjectInformation(subjectIndex).usableSamples = ...
        usableSamples;

    subjectInformation(subjectIndex).availableDuration = ...
        availableDuration;

    fprintf( ...
        'Infant %d: %.2f hours\n', ...
        infant, ...
        availableDuration / 3600);
end

%% Find the shortest recording

availableDurations = [ ...
    subjectInformation.availableDuration];

commonDurationSeconds = min( ...
    availableDurations);

fprintf('\nCommon duration: %.2f hours\n', ...
    commonDurationSeconds / 3600);

%% Generate CSV files

for subjectIndex = 1:numberOfSubjects

    infant = ...
        subjectInformation(subjectIndex).infant;

    recordName = ...
        subjectInformation(subjectIndex).recordName;

    info = ...
        subjectInformation(subjectIndex).info;

    writeBradyCSV = ...
        ismember(infant, bradyOnlyInfants);

    writeHeartRateCSV = ...
        ismember(infant, heartRateInfants);

    samplesToUse = floor( ...
        commonDurationSeconds * info.Fs);

    samplesToUse = min( ...
        samplesToUse, ...
        subjectInformation(subjectIndex).usableSamples);

    fprintf('\nProcessing infant %d\n', infant);
    fprintf('Sampling frequency: %.0f Hz\n', info.Fs);
    fprintf('Samples used: %d\n', samplesToUse);

    %% Read annotations

    bradySamples = double( ...
        rdann(recordName, 'atr'));

    bradySamples = round( ...
        bradySamples(:));

    bradySamples = bradySamples( ...
        bradySamples >= 0 & ...
        bradySamples < samplesToUse);

    if writeHeartRateCSV

        rPeakSamples = double( ...
            rdann(recordName, 'qrsc'));

        rPeakSamples = round( ...
            rPeakSamples(:));

        rPeakSamples = rPeakSamples( ...
            rPeakSamples >= 0 & ...
            rPeakSamples < samplesToUse);

    else

        rPeakSamples = [];
    end

    %% Output files

    bradyOutputFile = fullfile( ...
        outputFolder, ...
        [recordName '.csv']);

    heartRateOutputFile = fullfile( ...
        outputFolder, ...
        [recordName '_hr.csv']);

    if writeBradyCSV

        fileID = fopen( ...
            bradyOutputFile, ...
            'w');

        fprintf( ...
            fileID, ...
            'sample,ecg,brady\n');

        fclose(fileID);
    end

    if writeHeartRateCSV

        fileID = fopen( ...
            heartRateOutputFile, ...
            'w');

        fprintf( ...
            fileID, ...
            'sample,ecg,brady,rpeak\n');

        fclose(fileID);
    end

    %% Process ECG in chunks

    numberOfChunks = ceil( ...
        samplesToUse / chunkSize);

    for chunkNumber = 1:numberOfChunks

        firstSample = ...
            (chunkNumber - 1) * chunkSize;

        currentChunkSize = min( ...
            chunkSize, ...
            samplesToUse - firstSample);

        lastSample = ...
            firstSample + currentChunkSize - 1;

        signal = readWFDB16Chunk( ...
            info, ...
            firstSample, ...
            currentChunkSize);

        ecg = ...
            signal(:, 1);

        sample = double( ...
            (firstSample:lastSample)');

        %% Bradycardia labels

        brady = zeros( ...
            currentChunkSize, ...
            1);

        bradyInChunk = bradySamples( ...
            bradySamples >= firstSample & ...
            bradySamples <= lastSample);

        bradyRows = round( ...
            bradyInChunk - firstSample + 1);

        brady(bradyRows) = 1;

        %% R-peak labels

        if writeHeartRateCSV

            rpeak = zeros( ...
                currentChunkSize, ...
                1);

            rPeaksInChunk = rPeakSamples( ...
                rPeakSamples >= firstSample & ...
                rPeakSamples <= lastSample);

            rPeakRows = round( ...
                rPeaksInChunk - firstSample + 1);

            rpeak(rPeakRows) = 1;
        end

        %% Write CSV files

        if writeBradyCSV

            writematrix( ...
                [sample ecg brady], ...
                bradyOutputFile, ...
                'WriteMode', ...
                'append');
        end

        if writeHeartRateCSV

            writematrix( ...
                [sample ecg brady rpeak], ...
                heartRateOutputFile, ...
                'WriteMode', ...
                'append');
        end

        fprintf( ...
            'Infant %d: chunk %d/%d\n', ...
            infant, ...
            chunkNumber, ...
            numberOfChunks);
    end
end

fprintf('\nCSV files saved in:\n%s\n', ...
    outputFolder);

%% ================================================================
% Local functions
% ================================================================

function info = readWFDBHeader( ...
        headerFile, ...
        datasetFolder)
% Read WFDB header information.

    fileID = fopen( ...
        headerFile, ...
        'r');

    firstTokens = strsplit( ...
        strtrim(fgetl(fileID)));

    info.recordName = ...
        firstTokens{1};

    info.nSignals = ...
        str2double(firstTokens{2});

    samplingText = regexp( ...
        firstTokens{3}, ...
        '^[0-9.]+', ...
        'match', ...
        'once');

    info.Fs = ...
        str2double(samplingText);

    info.nSamples = ...
        str2double(firstTokens{4});

    info.gains = ones( ...
        1, ...
        info.nSignals);

    info.baselines = zeros( ...
        1, ...
        info.nSignals);

    dataFileName = '';
    byteOffset = 0;

    for channel = 1:info.nSignals

        signalTokens = strsplit( ...
            strtrim(fgetl(fileID)));

        if channel == 1

            dataFileName = ...
                signalTokens{1};

            formatToken = ...
                signalTokens{2};

            offsetText = regexp( ...
                formatToken, ...
                '\+(\d+)', ...
                'tokens', ...
                'once');

            if ~isempty(offsetText)

                byteOffset = ...
                    str2double(offsetText{1});
            end
        end

        gainToken = ...
            signalTokens{3};

        gainText = regexp( ...
            gainToken, ...
            '^[+-]?[0-9]*\.?[0-9]+', ...
            'match', ...
            'once');

        info.gains(channel) = ...
            str2double(gainText);

        baselineText = regexp( ...
            gainToken, ...
            '\(([+-]?\d+)\)', ...
            'tokens', ...
            'once');

        if isempty(baselineText)

            info.baselines(channel) = ...
                str2double(signalTokens{5});

        else

            info.baselines(channel) = ...
                str2double(baselineText{1});
        end
    end

    fclose(fileID);

    info.dataFile = fullfile( ...
        datasetFolder, ...
        dataFileName);

    info.byteOffset = ...
        byteOffset;
end


function signal = readWFDB16Chunk( ...
        info, ...
        firstSample, ...
        sampleCount)
% Read one chunk from a WFDB format 16 DAT file.

    fileID = fopen( ...
        info.dataFile, ...
        'r', ...
        'ieee-le');

    bytePosition = ...
        info.byteOffset + ...
        firstSample * ...
        info.nSignals * 2;

    fseek( ...
        fileID, ...
        bytePosition, ...
        'bof');

    rawSignal = fread( ...
        fileID, ...
        [info.nSignals sampleCount], ...
        'int16=>double');

    fclose(fileID);

    rawSignal = ...
        rawSignal';

    signal = ...
        (rawSignal - info.baselines) ./ ...
        info.gains;
end

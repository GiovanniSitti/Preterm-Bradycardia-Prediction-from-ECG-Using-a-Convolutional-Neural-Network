%% MANUAL ECG PREPROCESSING

clear;
clc;
close all;

%% Configuration

patient = 1;
eventNumber = 1;

secondsBefore = 60;
secondsAfter = 20;

targetFs = 250;

lowCutoff = 0.5;
highCutoff = 40;

notchFrequency = 50;
notchQualityFactor = 35;

%% Dataset folder

datasetFolder = fullfile( ...
    getenv('USERPROFILE'), ...
    'Desktop', ...
    'PRJ_A', ...
    'PICS_ECG');

originalFolder = pwd;
folderCleanup = onCleanup(@() cd(originalFolder));

cd(datasetFolder);

%% Record information

recordName = sprintf( ...
    'infant%d_ecg', ...
    patient);

headerFile = ...
    [recordName '.hea'];

fileID = fopen( ...
    headerFile, ...
    'r');

firstLine = fgetl(fileID);

fclose(fileID);

headerTokens = strsplit( ...
    strtrim(firstLine));

numberOfChannels = str2double( ...
    headerTokens{2});

samplingText = regexp( ...
    headerTokens{3}, ...
    '^[0-9.]+', ...
    'match', ...
    'once');

Fs = str2double( ...
    samplingText);

totalSamples = str2double( ...
    headerTokens{4});

fprintf('Patient: %d\n', patient);
fprintf('Sampling frequency: %.0f Hz\n', Fs);
fprintf('Number of channels: %d\n', numberOfChannels);

%% Read bradycardia annotations

bradySamples = double( ...
    rdann(recordName, 'atr'));

bradySamples = ...
    bradySamples(:);

%% Select the bradycardia event

eventSample = ...
    bradySamples(eventNumber);

firstSample = max( ...
    1, ...
    round( ...
        eventSample - ...
        secondsBefore * Fs));

lastSample = min( ...
    totalSamples, ...
    round( ...
        eventSample + ...
        secondsAfter * Fs));

%% Read the raw ECG segment

ecgRaw = rdsamp( ...
    recordName, ...
    1:numberOfChannels, ...
    lastSample, ...
    firstSample);

ecgRaw = double( ...
    ecgRaw);

%% Create the original time vector

sampleNumbers = ...
    firstSample + ...
    (0:size(ecgRaw, 1)-1)';

timeRaw = ...
    (sampleNumbers - eventSample) / Fs;

%% Step 1: remove the DC component

ecgCentered = ...
    ecgRaw - mean(ecgRaw, 1);

%% Step 2: band-pass filtering

normalizedBand = ...
    [lowCutoff highCutoff] / ...
    (Fs / 2);

[bandpassB, bandpassA] = butter( ...
    4, ...
    normalizedBand, ...
    'bandpass');

ecgBandpass = filtfilt( ...
    bandpassB, ...
    bandpassA, ...
    ecgCentered);

%% Step 3: 50 Hz notch filtering

normalizedNotch = ...
    notchFrequency / ...
    (Fs / 2);

notchBandwidth = ...
    normalizedNotch / ...
    notchQualityFactor;

[notchB, notchA] = iirnotch( ...
    normalizedNotch, ...
    notchBandwidth);

ecgFiltered = filtfilt( ...
    notchB, ...
    notchA, ...
    ecgBandpass);

%% Step 4: resampling

ecgResampled = resample( ...
    ecgFiltered, ...
    targetFs, ...
    Fs);

timeProcessed = linspace( ...
    timeRaw(1), ...
    timeRaw(end), ...
    size(ecgResampled, 1))';

%% Step 5: channel normalization

channelMean = mean( ...
    ecgResampled, ...
    1);

channelStd = std( ...
    ecgResampled, ...
    0, ...
    1);

channelStd = max( ...
    channelStd, ...
    eps);

ecgProcessed = ...
    (ecgResampled - channelMean) ./ ...
    channelStd;

%% Display information

fprintf('\nPreprocessing completed.\n');

fprintf('Original sampling frequency: %.0f Hz\n', ...
    Fs);

fprintf('Final sampling frequency: %.0f Hz\n', ...
    targetFs);

fprintf('Original samples: %d\n', ...
    size(ecgRaw, 1));

fprintf('Processed samples: %d\n', ...
    size(ecgProcessed, 1));

%% Plot preprocessing stages

figure( ...
    'Color', 'w', ...
    'Name', sprintf( ...
        'Patient %d ECG preprocessing', ...
        patient), ...
    'NumberTitle', 'off', ...
    'Units', 'normalized', ...
    'Position', [0.08 0.08 0.84 0.82]);

layout = tiledlayout( ...
    3, ...
    1, ...
    'TileSpacing', 'compact', ...
    'Padding', 'compact');

%% Raw ECG

rawAxis = nexttile( ...
    layout);

plot( ...
    rawAxis, ...
    timeRaw, ...
    ecgRaw(:, 1), ...
    'LineWidth', ...
    0.8);

xline( ...
    rawAxis, ...
    0, ...
    '--', ...
    'Bradycardia onset', ...
    'LineWidth', ...
    1.5);

ylabel( ...
    rawAxis, ...
    'Amplitude');

title( ...
    rawAxis, ...
    'Raw ECG');

grid(rawAxis, 'on');
box(rawAxis, 'on');

%% Filtered ECG

filteredAxis = nexttile( ...
    layout);

plot( ...
    filteredAxis, ...
    timeRaw, ...
    ecgFiltered(:, 1), ...
    'LineWidth', ...
    0.8);

xline( ...
    filteredAxis, ...
    0, ...
    '--', ...
    'Bradycardia onset', ...
    'LineWidth', ...
    1.5);

ylabel( ...
    filteredAxis, ...
    'Amplitude');

title( ...
    filteredAxis, ...
    'Band-pass and notch filtered ECG');

grid(filteredAxis, 'on');
box(filteredAxis, 'on');

%% Resampled and normalized ECG

processedAxis = nexttile( ...
    layout);

plot( ...
    processedAxis, ...
    timeProcessed, ...
    ecgProcessed(:, 1), ...
    'LineWidth', ...
    0.8);

xline( ...
    processedAxis, ...
    0, ...
    '--', ...
    'Bradycardia onset', ...
    'LineWidth', ...
    1.5);

xlabel( ...
    processedAxis, ...
    'Time relative to bradycardia onset (s)');

ylabel( ...
    processedAxis, ...
    'Normalized amplitude');

title( ...
    processedAxis, ...
    'Resampled and normalized ECG');

grid(processedAxis, 'on');
box(processedAxis, 'on');

%% Link plot axes

linkaxes( ...
    [rawAxis filteredAxis processedAxis], ...
    'x');

xlim( ...
    rawAxis, ...
    [-secondsBefore secondsAfter]);

title( ...
    layout, ...
    sprintf( ...
        'Patient %d — Event %d — ECG preprocessing', ...
        patient, ...
        eventNumber), ...
    'FontWeight', ...
    'bold');

%% Save processed ECG

outputFolder = fullfile( ...
    getenv('USERPROFILE'), ...
    'Desktop', ...
    'PRJ_A', ...
    'PREPROCESSED_ECG');

mkdir(outputFolder);

outputFile = fullfile( ...
    outputFolder, ...
    sprintf( ...
        'infant%d_event%d_preprocessed.mat', ...
        patient, ...
        eventNumber));

save( ...
    outputFile, ...
    'ecgRaw', ...
    'ecgFiltered', ...
    'ecgProcessed', ...
    'timeRaw', ...
    'timeProcessed', ...
    'Fs', ...
    'targetFs', ...
    'patient', ...
    'eventNumber', ...
    'eventSample');

fprintf('\nProcessed ECG saved in:\n%s\n', ...
    outputFile);

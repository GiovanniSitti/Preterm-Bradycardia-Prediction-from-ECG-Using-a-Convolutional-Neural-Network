%% FULLY CONVOLUTIONAL NETWORK FOR BRADYCARDIA PREDICTION

%
% Architecture:
%   Conv1D: 1 -> 128, kernel 8
%   Batch normalization
%   ReLU
%   Conv1D: 128 -> 256, kernel 5
%   Batch normalization
%   ReLU
%   Conv1D: 256 -> 128, kernel 3
%   Batch normalization
%   ReLU
%   Average pooling, kernel 2
%   Global average pooling
%   Fully connected layer
%
% Training:
%   Adam
%   Learning rate: 0.001
%   Batch size: 32
%   Epochs: 1000
%   Cross-entropy loss

clear;
clc;
close all;

rng(0);

%% Paths


datasetFile = fullfile( ...
    projectFolder, ...
    '3min_250_common_duration.mat');

resultsFile = fullfile( ...
    projectFolder, ...
    'FCN_original_parameters.mat');

predictionsFile = fullfile( ...
    projectFolder, ...
    'FCN_test_predictions.csv');

%% Original GitHub parameters

miniBatchSize = 32;
learningRate = 0.001;
epochs = 1000;

% Defined in the original implementation but not used by the FCN.
drop = 0.2; %#ok<NASGU>

%% Load the prepared ECG windows

data = load(datasetFile);

ecgWindows = single(data.ecgWindows);
labels = double(data.labels(:));

infantNumbers = double( ...
    data.infantNumbers(:));

pairNumbers = double( ...
    data.pairNumbers(:));

numberOfTimeSteps = ...
    size(ecgWindows, 2);

%% Original 70/30 chronological split for each infant

trainingMask = false( ...
    size(ecgWindows, 1), ...
    1);

testMask = false( ...
    size(ecgWindows, 1), ...
    1);

infants = unique( ...
    infantNumbers, ...
    'stable');

for infantIndex = 1:numel(infants)

    infant = infants(infantIndex);

    infantMask = ...
        infantNumbers == infant;

    infantPairNumbers = ...
        pairNumbers(infantMask);

    splitThreshold = ...
        max(infantPairNumbers) * 0.70;

    trainingMask(infantMask) = ...
        infantPairNumbers <= splitThreshold;

    testMask(infantMask) = ...
        infantPairNumbers > splitThreshold;
end

%% Extract training and test data

trainingMatrix = ...
    ecgWindows(trainingMask, :);

testMatrix = ...
    ecgWindows(testMask, :);

trainingLabels = ...
    labels(trainingMask);

testLabels = ...
    labels(testMask);

testInfants = ...
    infantNumbers(testMask);

testPairs = ...
    pairNumbers(testMask);

clear ecgWindows;

%% Convert observations to MATLAB sequences

trainingX = num2cell( ...
    trainingMatrix, ...
    2);

testX = num2cell( ...
    testMatrix, ...
    2);

clear trainingMatrix testMatrix;

%% Class labels

classNames = { ...
    'Control', ...
    'PreBradycardia'};

trainingY = categorical( ...
    trainingLabels, ...
    [1 2], ...
    classNames);

testY = categorical( ...
    testLabels, ...
    [1 2], ...
    classNames);

%% FCN architecture

layers = [

    sequenceInputLayer( ...
        1, ...
        'MinLength', ...
        numberOfTimeSteps, ...
        'Normalization', ...
        'none', ...
        'Name', ...
        'input')

    convolution1dLayer( ...
        8, ...
        128, ...
        'Stride', ...
        1, ...
        'Padding', ...
        0, ...
        'Name', ...
        'conv1')

    batchNormalizationLayer( ...
        'Name', ...
        'batchnorm1')

    reluLayer( ...
        'Name', ...
        'relu1')

    convolution1dLayer( ...
        5, ...
        256, ...
        'Stride', ...
        1, ...
        'Padding', ...
        0, ...
        'Name', ...
        'conv2')

    batchNormalizationLayer( ...
        'Name', ...
        'batchnorm2')

    reluLayer( ...
        'Name', ...
        'relu2')

    convolution1dLayer( ...
        3, ...
        128, ...
        'Stride', ...
        1, ...
        'Padding', ...
        0, ...
        'Name', ...
        'conv3')

    batchNormalizationLayer( ...
        'Name', ...
        'batchnorm3')

    reluLayer( ...
        'Name', ...
        'relu3')

    averagePooling1dLayer( ...
        2, ...
        'Stride', ...
        2, ...
        'Name', ...
        'average_pooling')

    globalAveragePooling1dLayer( ...
        'Name', ...
        'global_average_pooling')

    fullyConnectedLayer( ...
        2, ...
        'Name', ...
        'fully_connected')

    softmaxLayer( ...
        'Name', ...
        'softmax')

    classificationLayer( ...
        'Name', ...
        'classification')
];

%% Training configuration

iterationsPerEpoch = ceil( ...
    numel(trainingX) / miniBatchSize);

options = trainingOptions( ...
    'adam', ...
    'InitialLearnRate', ...
    learningRate, ...
    'GradientDecayFactor', ...
    0.9, ...
    'SquaredGradientDecayFactor', ...
    0.999, ...
    'Epsilon', ...
    1e-8, ...
    'L2Regularization', ...
    0, ...
    'MaxEpochs', ...
    epochs, ...
    'MiniBatchSize', ...
    miniBatchSize, ...
    'Shuffle', ...
    'every-epoch', ...
    'ValidationData', ...
    {testX testY}, ...
    'ValidationFrequency', ...
    iterationsPerEpoch, ...
    'ExecutionEnvironment', ...
    'gpu', ...
    'Verbose', ...
    true, ...
    'VerboseFrequency', ...
    iterationsPerEpoch, ...
    'Plots', ...
    'training-progress');

%% Train the FCN

[trainedNetwork, trainingInfo] = trainNetwork( ...
    trainingX, ...
    trainingY, ...
    layers, ...
    options);

%% Test the network

[predictedY, testScores] = classify( ...
    trainedNetwork, ...
    testX, ...
    'MiniBatchSize', ...
    miniBatchSize, ...
    'ExecutionEnvironment', ...
    'gpu');

testAccuracy = mean( ...
    predictedY == testY) * 100;

%% Confusion matrix

confusionMatrix = confusionmat( ...
    testY, ...
    predictedY, ...
    'Order', ...
    categorical(classNames));

%% Classification metrics

truePositive = diag( ...
    confusionMatrix);

predictedTotal = sum( ...
    confusionMatrix, ...
    1)';

actualTotal = sum( ...
    confusionMatrix, ...
    2);

precision = ...
    truePositive ./ predictedTotal;

recall = ...
    truePositive ./ actualTotal;

f1Score = ...
    2 .* precision .* recall ./ ...
    (precision + recall);

metricsTable = table( ...
    string(classNames(:)), ...
    precision, ...
    recall, ...
    f1Score, ...
    actualTotal, ...
    'VariableNames', { ...
        'Class', ...
        'Precision', ...
        'Recall', ...
        'F1Score', ...
        'Support'});

%% Display results

fprintf('\n');
fprintf('========================================\n');
fprintf('FCN TEST RESULTS\n');
fprintf('========================================\n');

fprintf('Training observations: %d\n', ...
    numel(trainingX));

fprintf('Test observations: %d\n', ...
    numel(testX));

fprintf('Epochs: %d\n', ...
    epochs);

fprintf('Batch size: %d\n', ...
    miniBatchSize);

fprintf('Learning rate: %.4f\n', ...
    learningRate);

fprintf('Test accuracy: %.2f%%\n', ...
    testAccuracy);

fprintf('\nConfusion matrix:\n');
disp(confusionMatrix);

fprintf('\nClassification metrics:\n');
disp(metricsTable);

%% Plot confusion matrix

figure( ...
    'Color', ...
    'w', ...
    'Name', ...
    'FCN test confusion matrix', ...
    'NumberTitle', ...
    'off');

confusionObject = confusionchart( ...
    testY, ...
    predictedY);

confusionObject.Title = sprintf( ...
    'FCN test accuracy: %.2f%%', ...
    testAccuracy);

confusionObject.RowSummary = ...
    'row-normalized';

confusionObject.ColumnSummary = ...
    'column-normalized';

%% Save test predictions

testResults = table( ...
    testInfants, ...
    testPairs, ...
    testY, ...
    predictedY, ...
    testScores(:, 1), ...
    testScores(:, 2), ...
    'VariableNames', { ...
        'Infant', ...
        'BradycardiaNumber', ...
        'TrueClass', ...
        'PredictedClass', ...
        'ControlProbability', ...
        'PreBradycardiaProbability'});

writetable( ...
    testResults, ...
    predictionsFile);

%% Save the trained model

save( ...
    resultsFile, ...
    'trainedNetwork', ...
    'trainingInfo', ...
    'testResults', ...
    'testAccuracy', ...
    'confusionMatrix', ...
    'metricsTable', ...
    'miniBatchSize', ...
    'learningRate', ...
    'epochs', ...
    'classNames', ...
    '-v7.3');


%% 
%% FCN BRADYCARDIA PREDICTION
% 1. Within-subject chronological 70/30 hold-out
% 2. Leave-One-Infant-Out cross-validation with 20 infants

clear;
clc;
close all;

rng(0);

%% Configuration

projectFolder = fullfile( ...
    getenv('USERPROFILE'), ...
    'Desktop', ...
    'PRJ_A');

datasetFile = fullfile( ...
    projectFolder, ...
    'PICS_3min_250_common_duration.mat');

miniBatchSize = 32;
learningRate = 0.001;
epochs = 1000;

classNames = { ...
    'Control', ...
    'PreBradycardia'};

metricNames = { ...
    'Accuracy', ...
    'Sensitivity', ...
    'Specificity', ...
    'Precision', ...
    'F1Score'};

%% Load dataset

data = load(datasetFile);

ecgWindows = single( ...
    data.ecgWindows);

labels = double( ...
    data.labels(:));

infantNumbers = double( ...
    data.infantNumbers(:));

pairNumbers = double( ...
    data.pairNumbers(:));

numberOfTimeSteps = size( ...
    ecgWindows, ...
    2);

infants = unique( ...
    infantNumbers, ...
    'stable');

numberOfFolds = numel( ...
    infants);

X = num2cell( ...
    ecgWindows, ...
    2);

Y = categorical( ...
    labels, ...
    [1 2], ...
    classNames);

clear ecgWindows data;

fprintf('Subjects: %d\n', numberOfFolds);
fprintf('Observations: %d\n', numel(labels));
fprintf('ECG samples per observation: %d\n', numberOfTimeSteps);

%% ================================================================
% WITHIN-SUBJECT CHRONOLOGICAL 70/30 HOLD-OUT
% ================================================================

chronologicalTrainingMask = false( ...
    size(labels));

chronologicalTestMask = false( ...
    size(labels));

for infantIndex = 1:numberOfFolds

    infant = infants(infantIndex);

    infantMask = ...
        infantNumbers == infant;

    splitThreshold = ...
        max(pairNumbers(infantMask)) * 0.70;

    chronologicalTrainingMask(infantMask) = ...
        pairNumbers(infantMask) <= splitThreshold;

    chronologicalTestMask(infantMask) = ...
        pairNumbers(infantMask) > splitThreshold;
end

fprintf('\n');
fprintf('========================================\n');
fprintf('CHRONOLOGICAL 70/30 HOLD-OUT\n');
fprintf('========================================\n');

chronologicalNetwork = trainFCN( ...
    X(chronologicalTrainingMask), ...
    Y(chronologicalTrainingMask), ...
    numberOfTimeSteps, ...
    miniBatchSize, ...
    learningRate, ...
    epochs);

chronologicalPredictions = classify( ...
    chronologicalNetwork, ...
    X(chronologicalTestMask), ...
    'MiniBatchSize', ...
    miniBatchSize, ...
    'ExecutionEnvironment', ...
    'gpu');

chronologicalPredictionsNumeric = ...
    double(chronologicalPredictions == 'PreBradycardia') + 1;

chronologicalMetrics = classificationMetrics( ...
    labels(chronologicalTestMask), ...
    chronologicalPredictionsNumeric);

chronologicalResults = array2table( ...
    chronologicalMetrics, ...
    'VariableNames', ...
    metricNames);

disp(chronologicalResults);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

fprintf('\n');
fprintf('========================================\n');
fprintf('LEAVE-ONE-INFANT-OUT CROSS-VALIDATION\n');
fprintf('========================================\n');

foldMetrics = zeros( ...
    numberOfFolds, ...
    numel(metricNames));

loioPredictions = zeros( ...
    size(labels));

for fold = 1:numberOfFolds

    testInfant = ...
        infants(fold);

    trainingMask = ...
        infantNumbers ~= testInfant;

    testMask = ...
        infantNumbers == testInfant;

    fprintf('\nFold %d/%d - Test infant %d\n', ...
        fold, ...
        numberOfFolds, ...
        testInfant);

    foldNetwork = trainFCN( ...
        X(trainingMask), ...
        Y(trainingMask), ...
        numberOfTimeSteps, ...
        miniBatchSize, ...
        learningRate, ...
        epochs);

    foldPredictions = classify( ...
        foldNetwork, ...
        X(testMask), ...
        'MiniBatchSize', ...
        miniBatchSize, ...
        'ExecutionEnvironment', ...
        'gpu');

    foldPredictionsNumeric = ...
        double(foldPredictions == 'PreBradycardia') + 1;

    loioPredictions(testMask) = ...
        foldPredictionsNumeric;

    foldMetrics(fold, :) = classificationMetrics( ...
        labels(testMask), ...
        foldPredictionsNumeric);

    fprintf('Accuracy: %.2f%%\n', ...
        foldMetrics(fold, 1));

    fprintf('Sensitivity: %.2f%%\n', ...
        foldMetrics(fold, 2));

    fprintf('Specificity: %.2f%%\n', ...
        foldMetrics(fold, 3));

    fprintf('Precision: %.2f%%\n', ...
        foldMetrics(fold, 4));

    fprintf('F1-score: %.2f%%\n', ...
        foldMetrics(fold, 5));

    clear foldNetwork;
end

%% LOIO fold results

loioFoldResults = array2table( ...
    [infants(:) foldMetrics], ...
    'VariableNames', ...
    [{'TestInfant'} metricNames]);

%% Mean and standard deviation across the 20 folds

meanFoldMetrics = mean( ...
    foldMetrics, ...
    1);

standardDeviationFoldMetrics = std( ...
    foldMetrics, ...
    0, ...
    1);

%% Metrics calculated from all pooled LOIO predictions

overallLOIOMetrics = classificationMetrics( ...
    labels, ...
    loioPredictions);

loioSummary = array2table( ...
    [ ...
        meanFoldMetrics
        standardDeviationFoldMetrics
        overallLOIOMetrics ...
    ], ...
    'VariableNames', ...
    metricNames, ...
    'RowNames', { ...
        'MeanAcrossInfants', ...
        'StandardDeviation', ...
        'OverallPooled'});

fprintf('\n');
fprintf('========================================\n');
fprintf('LOIO RESULTS FOR ALL INFANTS\n');
fprintf('========================================\n');

disp(loioFoldResults);

fprintf('\nLOIO summary:\n');

disp(loioSummary);

%% Save only networks and metrics

writetable( ...
    chronologicalResults, ...
    fullfile( ...
        projectFolder, ...
        'FCN_chronological_metrics.csv'));

writetable( ...
    loioFoldResults, ...
    fullfile( ...
        projectFolder, ...
        'FCN_LOIO_metrics_by_infant.csv'));

writetable( ...
    loioSummary, ...
    fullfile( ...
        projectFolder, ...
        'FCN_LOIO_summary.csv'), ...
    'WriteRowNames', ...
    true);

save( ...
    fullfile( ...
        projectFolder, ...
        'FCN_validation_results.mat'), ...
    'chronologicalNetwork', ...
    'chronologicalResults', ...
    'loioFoldResults', ...
    'loioSummary', ...
    'miniBatchSize', ...
    'learningRate', ...
    'epochs', ...
    '-v7.3');

%% ================================================================
% LOCAL FUNCTIONS
% ================================================================

function network = trainFCN( ...
        trainingX, ...
        trainingY, ...
        numberOfTimeSteps, ...
        miniBatchSize, ...
        learningRate, ...
        epochs)

    layers = [

        sequenceInputLayer( ...
            1, ...
            'MinLength', ...
            numberOfTimeSteps, ...
            'Normalization', ...
            'none')

        convolution1dLayer( ...
            8, ...
            128, ...
            'Stride', ...
            1, ...
            'Padding', ...
            0)

        batchNormalizationLayer
        reluLayer

        convolution1dLayer( ...
            5, ...
            256, ...
            'Stride', ...
            1, ...
            'Padding', ...
            0)

        batchNormalizationLayer
        reluLayer

        convolution1dLayer( ...
            3, ...
            128, ...
            'Stride', ...
            1, ...
            'Padding', ...
            0)

        batchNormalizationLayer
        reluLayer

        averagePooling1dLayer( ...
            2, ...
            'Stride', ...
            2)

        globalAveragePooling1dLayer

        fullyConnectedLayer(2)
        softmaxLayer
        classificationLayer
    ];

    options = trainingOptions( ...
        'adam', ...
        'InitialLearnRate', ...
        learningRate, ...
        'GradientDecayFactor', ...
        0.9, ...
        'SquaredGradientDecayFactor', ...
        0.999, ...
        'Epsilon', ...
        1e-8, ...
        'L2Regularization', ...
        0, ...
        'MaxEpochs', ...
        epochs, ...
        'MiniBatchSize', ...
        miniBatchSize, ...
        'Shuffle', ...
        'every-epoch', ...
        'ExecutionEnvironment', ...
        'gpu', ...
        'Verbose', ...
        false, ...
        'Plots', ...
        'none');

    network = trainNetwork( ...
        trainingX, ...
        trainingY, ...
        layers, ...
        options);
end


function metrics = classificationMetrics( ...
        trueLabels, ...
        predictedLabels)

    trueLabels = double( ...
        trueLabels(:));

    predictedLabels = double( ...
        predictedLabels(:));

    truePositive = sum( ...
        trueLabels == 2 & ...
        predictedLabels == 2);

    trueNegative = sum( ...
        trueLabels == 1 & ...
        predictedLabels == 1);

    falsePositive = sum( ...
        trueLabels == 1 & ...
        predictedLabels == 2);

    falseNegative = sum( ...
        trueLabels == 2 & ...
        predictedLabels == 1);

    accuracy = ...
        100 * ...
        (truePositive + trueNegative) / ...
        numel(trueLabels);

    sensitivity = ...
        100 * ...
        truePositive / ...
        max(truePositive + falseNegative, eps);

    specificity = ...
        100 * ...
        trueNegative / ...
        max(trueNegative + falsePositive, eps);

    precision = ...
        100 * ...
        truePositive / ...
        max(truePositive + falsePositive, eps);

    f1Score = ...
        2 * precision * sensitivity / ...
        max(precision + sensitivity, eps);

    metrics = [ ...
        accuracy, ...
        sensitivity, ...
        specificity, ...
        precision, ...
        f1Score];
end

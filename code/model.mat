%% FULLY CONVOLUTIONAL NETWORK FOR BRADYCARDIA PREDICTION

%
% Architecture:
%   Conv1D: 1 -> 128, kernel 8
%   Batch normalization
%   ReLU
%   Conv1D: 128 -> 256, kernel 5
%   Batch normalization
%   ReLU
%   Conv1D: 256 -> 128, kernel 3
%   Batch normalization
%   ReLU
%   Average pooling, kernel 2
%   Global average pooling
%   Fully connected layer
%
% Training:
%   Adam
%   Learning rate: 0.001
%   Batch size: 32
%   Epochs: 1000
%   Cross-entropy loss

clear;
clc;
close all;

rng(0);

%% Paths


datasetFile = fullfile( ...
    projectFolder, ...
    '3min_250_common_duration.mat');

resultsFile = fullfile( ...
    projectFolder, ...
    'FCN_original_parameters.mat');

predictionsFile = fullfile( ...
    projectFolder, ...
    'FCN_test_predictions.csv');

%% Original GitHub parameters

miniBatchSize = 32;
learningRate = 0.001;
epochs = 1000;

% Defined in the original implementation but not used by the FCN.
drop = 0.2; %#ok<NASGU>

%% Load the prepared ECG windows

data = load(datasetFile);

ecgWindows = single(data.ecgWindows);
labels = double(data.labels(:));

infantNumbers = double( ...
    data.infantNumbers(:));

pairNumbers = double( ...
    data.pairNumbers(:));

numberOfTimeSteps = ...
    size(ecgWindows, 2);

%% Original 70/30 chronological split for each infant

trainingMask = false( ...
    size(ecgWindows, 1), ...
    1);

testMask = false( ...
    size(ecgWindows, 1), ...
    1);

infants = unique( ...
    infantNumbers, ...
    'stable');

for infantIndex = 1:numel(infants)

    infant = infants(infantIndex);

    infantMask = ...
        infantNumbers == infant;

    infantPairNumbers = ...
        pairNumbers(infantMask);

    splitThreshold = ...
        max(infantPairNumbers) * 0.70;

    trainingMask(infantMask) = ...
        infantPairNumbers <= splitThreshold;

    testMask(infantMask) = ...
        infantPairNumbers > splitThreshold;
end

%% Extract training and test data

trainingMatrix = ...
    ecgWindows(trainingMask, :);

testMatrix = ...
    ecgWindows(testMask, :);

trainingLabels = ...
    labels(trainingMask);

testLabels = ...
    labels(testMask);

testInfants = ...
    infantNumbers(testMask);

testPairs = ...
    pairNumbers(testMask);

clear ecgWindows;

%% Convert observations to MATLAB sequences

trainingX = num2cell( ...
    trainingMatrix, ...
    2);

testX = num2cell( ...
    testMatrix, ...
    2);

clear trainingMatrix testMatrix;

%% Class labels

classNames = { ...
    'Control', ...
    'PreBradycardia'};

trainingY = categorical( ...
    trainingLabels, ...
    [1 2], ...
    classNames);

testY = categorical( ...
    testLabels, ...
    [1 2], ...
    classNames);

%% FCN architecture

layers = [

    sequenceInputLayer( ...
        1, ...
        'MinLength', ...
        numberOfTimeSteps, ...
        'Normalization', ...
        'none', ...
        'Name', ...
        'input')

    convolution1dLayer( ...
        8, ...
        128, ...
        'Stride', ...
        1, ...
        'Padding', ...
        0, ...
        'Name', ...
        'conv1')

    batchNormalizationLayer( ...
        'Name', ...
        'batchnorm1')

    reluLayer( ...
        'Name', ...
        'relu1')

    convolution1dLayer( ...
        5, ...
        256, ...
        'Stride', ...
        1, ...
        'Padding', ...
        0, ...
        'Name', ...
        'conv2')

    batchNormalizationLayer( ...
        'Name', ...
        'batchnorm2')

    reluLayer( ...
        'Name', ...
        'relu2')

    convolution1dLayer( ...
        3, ...
        128, ...
        'Stride', ...
        1, ...
        'Padding', ...
        0, ...
        'Name', ...
        'conv3')

    batchNormalizationLayer( ...
        'Name', ...
        'batchnorm3')

    reluLayer( ...
        'Name', ...
        'relu3')

    averagePooling1dLayer( ...
        2, ...
        'Stride', ...
        2, ...
        'Name', ...
        'average_pooling')

    globalAveragePooling1dLayer( ...
        'Name', ...
        'global_average_pooling')

    fullyConnectedLayer( ...
        2, ...
        'Name', ...
        'fully_connected')

    softmaxLayer( ...
        'Name', ...
        'softmax')

    classificationLayer( ...
        'Name', ...
        'classification')
];

%% Training configuration

iterationsPerEpoch = ceil( ...
    numel(trainingX) / miniBatchSize);

options = trainingOptions( ...
    'adam', ...
    'InitialLearnRate', ...
    learningRate, ...
    'GradientDecayFactor', ...
    0.9, ...
    'SquaredGradientDecayFactor', ...
    0.999, ...
    'Epsilon', ...
    1e-8, ...
    'L2Regularization', ...
    0, ...
    'MaxEpochs', ...
    epochs, ...
    'MiniBatchSize', ...
    miniBatchSize, ...
    'Shuffle', ...
    'every-epoch', ...
    'ValidationData', ...
    {testX testY}, ...
    'ValidationFrequency', ...
    iterationsPerEpoch, ...
    'ExecutionEnvironment', ...
    'gpu', ...
    'Verbose', ...
    true, ...
    'VerboseFrequency', ...
    iterationsPerEpoch, ...
    'Plots', ...
    'training-progress');

%% Train the FCN

[trainedNetwork, trainingInfo] = trainNetwork( ...
    trainingX, ...
    trainingY, ...
    layers, ...
    options);

%% Test the network

[predictedY, testScores] = classify( ...
    trainedNetwork, ...
    testX, ...
    'MiniBatchSize', ...
    miniBatchSize, ...
    'ExecutionEnvironment', ...
    'gpu');

testAccuracy = mean( ...
    predictedY == testY) * 100;

%% Confusion matrix

confusionMatrix = confusionmat( ...
    testY, ...
    predictedY, ...
    'Order', ...
    categorical(classNames));

%% Classification metrics

truePositive = diag( ...
    confusionMatrix);

predictedTotal = sum( ...
    confusionMatrix, ...
    1)';

actualTotal = sum( ...
    confusionMatrix, ...
    2);

precision = ...
    truePositive ./ predictedTotal;

recall = ...
    truePositive ./ actualTotal;

f1Score = ...
    2 .* precision .* recall ./ ...
    (precision + recall);

metricsTable = table( ...
    string(classNames(:)), ...
    precision, ...
    recall, ...
    f1Score, ...
    actualTotal, ...
    'VariableNames', { ...
        'Class', ...
        'Precision', ...
        'Recall', ...
        'F1Score', ...
        'Support'});

%% Display results

fprintf('\n');
fprintf('========================================\n');
fprintf('FCN TEST RESULTS\n');
fprintf('========================================\n');

fprintf('Training observations: %d\n', ...
    numel(trainingX));

fprintf('Test observations: %d\n', ...
    numel(testX));

fprintf('Epochs: %d\n', ...
    epochs);

fprintf('Batch size: %d\n', ...
    miniBatchSize);

fprintf('Learning rate: %.4f\n', ...
    learningRate);

fprintf('Test accuracy: %.2f%%\n', ...
    testAccuracy);

fprintf('\nConfusion matrix:\n');
disp(confusionMatrix);

fprintf('\nClassification metrics:\n');
disp(metricsTable);

%% Plot confusion matrix

figure( ...
    'Color', ...
    'w', ...
    'Name', ...
    'FCN test confusion matrix', ...
    'NumberTitle', ...
    'off');

confusionObject = confusionchart( ...
    testY, ...
    predictedY);

confusionObject.Title = sprintf( ...
    'FCN test accuracy: %.2f%%', ...
    testAccuracy);

confusionObject.RowSummary = ...
    'row-normalized';

confusionObject.ColumnSummary = ...
    'column-normalized';

%% Save test predictions

testResults = table( ...
    testInfants, ...
    testPairs, ...
    testY, ...
    predictedY, ...
    testScores(:, 1), ...
    testScores(:, 2), ...
    'VariableNames', { ...
        'Infant', ...
        'BradycardiaNumber', ...
        'TrueClass', ...
        'PredictedClass', ...
        'ControlProbability', ...
        'PreBradycardiaProbability'});

writetable( ...
    testResults, ...
    predictionsFile);

%% Save the trained model

save( ...
    resultsFile, ...
    'trainedNetwork', ...
    'trainingInfo', ...
    'testResults', ...
    'testAccuracy', ...
    'confusionMatrix', ...
    'metricsTable', ...
    'miniBatchSize', ...
    'learningRate', ...
    'epochs', ...
    'classNames', ...
    '-v7.3');
